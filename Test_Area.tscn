[sub_resource type="GDScript" id="GDScript_dmux5"]
script/source = "extends CharacterBody3D


const SPEED := 2
const JUMP_VELOCITY := 2.0

const INTERACTION_DISTANCE := 0.8
const INTERACTION_HEIGHT := 0.5


@onready var sprite: AnimatedSprite3D = $AnimatedSprite3D
@onready var interaction_area: Area3D = $InteractionArea


# Letzte Blickrichtung
var facing_direction: String = \"down\"


func _ready() -> void:
	update_interaction_area()


func _physics_process(delta: float) -> void:
	# Schwerkraft auf der Y-Achse
	if not is_on_floor():
		velocity += get_gravity() * delta
	else:
		velocity.y = 0.0


	# Springen auf der Y-Achse
	if Input.is_action_just_pressed(\"ui_accept\") and is_on_floor():
		velocity.y = JUMP_VELOCITY


	# Eingabe lesen
	var input_dir := Input.get_vector(
		\"ui_left\",
		\"ui_right\",
		\"ui_up\",
		\"ui_down\"
	)


	# Bewegung:
	# X = links/rechts
	# Y = Höhe, bleibt beim Laufen 0
	# Z = vorne/hinten
	var direction := Vector3(
		input_dir.x,
		0.0,
		input_dir.y
	).normalized()


	if direction != Vector3.ZERO:
		# Bewegung auf der X-Z-Bodenebene
		velocity.x = direction.x * SPEED
		velocity.z = direction.z * SPEED


		# Links/rechts
		if abs(input_dir.x) > abs(input_dir.y):
			if input_dir.x > 0.0:
				facing_direction = \"right\"
				sprite.play(\"walking_right\")
			else:
				facing_direction = \"left\"
				sprite.play(\"walking_left\")


		# Vorne/hinten
		else:
			if input_dir.y < 0.0:
				# ui_up beziehungsweise W
				# Negative Z-Richtung = FORWARD
				facing_direction = \"up\"
				sprite.play(\"walking_up\")
			else:
				# ui_down beziehungsweise S
				# Positive Z-Richtung = BACK
				facing_direction = \"down\"
				sprite.play(\"walking_down\")


	else:
		# Bewegung abbremsen
		velocity.x = move_toward(
			velocity.x,
			0.0,
			SPEED * 8.0 * delta
		)

		velocity.z = move_toward(
			velocity.z,
			0.0,
			SPEED * 8.0 * delta
		)

		# Idle-Animation passend zur Blickrichtung
		play_idle_animation()


	# Spieler bewegen
	move_and_slide()


	# Interaktionsbereich nach der Bewegung aktualisieren
	update_interaction_area()


func play_idle_animation() -> void:
	match facing_direction:
		\"down\":
			sprite.play(\"default\")

		\"left\":
			sprite.play(\"left\")

		\"right\":
			sprite.play(\"right\")

		\"up\":
			sprite.play(\"back\")


func update_interaction_area() -> void:
	var interaction_direction := Vector3.ZERO


	match facing_direction:
		\"up\":
			# Vor dem Spieler: negative Z-Achse
			interaction_direction = Vector3.FORWARD

		\"down\":
			# Hinter beziehungsweise vor dem Spieler:
			# positive Z-Achse
			interaction_direction = Vector3.BACK

		\"left\":
			# Negative X-Achse
			interaction_direction = Vector3.LEFT

		\"right\":
			# Positive X-Achse
			interaction_direction = Vector3.RIGHT


	# Die Area bleibt auf einer festen Höhe.
	# Nur X und Z bestimmen die Richtung.
	interaction_area.position = (
		Vector3.UP * INTERACTION_HEIGHT
		+ interaction_direction * INTERACTION_DISTANCE
	)


func _unhandled_input(event: InputEvent) -> void:
	if event.is_action_pressed(\"interact\"):
		interact_with_object()


func interact_with_object() -> void:
	var objects := interaction_area.get_overlapping_bodies()


	if objects.is_empty():
		print(\"Kein interaktives Objekt in Reichweite.\")
		return


	var target := get_closest_interactable(objects)


	if target == null:
		print(\"Kein interaktives Objekt gefunden.\")
		return


	target.interact(self)


func get_closest_interactable(objects: Array[Node3D]) -> Node3D:
	var closest_object: Node3D = null
	var closest_distance: float = INF


	for object in objects:
		if not object.has_method(\"interact\"):
			continue


		var distance := global_position.distance_squared_to(
			object.global_position
		)


		if distance < closest_distance:
			closest_distance = distance
			closest_object = object


	return closest_object
"

