[sub_resource type="GDScript" id="GDScript_07jwy"]
script/source = "extends CharacterBody3D


const SPEED = 1.5
const JUMP_VELOCITY = 4.5

@onready var sprite: AnimatedSprite3D = $AnimatedSprite3D


func _physics_process(delta: float) -> void:
	# Gravity
	if not is_on_floor():
		velocity += get_gravity() * delta

	# Jump
	if Input.is_action_just_pressed(\"ui_accept\") and is_on_floor():
		velocity.y = JUMP_VELOCITY

	# Bewegung
	var input_dir := Input.get_vector(
		\"ui_left\",
		\"ui_right\",
		\"ui_up\",
		\"ui_down\"
	)

	var direction := Vector3(input_dir.x, 0, input_dir.y).normalized()

	if direction:
		velocity.x = direction.x * SPEED
		velocity.z = direction.z * SPEED

		# Animation abhängig von der Bewegungsrichtung
		if abs(input_dir.x) > abs(input_dir.y):
			# Horizontal
			if input_dir.x > 0:
				sprite.play(\"walking_right\")
			else:
				sprite.play(\"walking_left\")
		else:
			# Vertikal
			if input_dir.y > 0:
				sprite.play(\"walking_down\")
			else:
				sprite.play(\"walking_up\")

	else:
		# Keine Bewegung
		velocity.x = move_toward(velocity.x, 0, SPEED)
		velocity.z = move_toward(velocity.z, 0, SPEED)

		# Letzte Blickrichtung beibehalten
		if sprite.animation.begins_with(\"walking_\"):
			match sprite.animation:
				\"walking_down\":
					sprite.play(\"default\")
				\"walking_left\":
					sprite.play(\"left\")
				\"walking_right\":
					sprite.play(\"right\")
				\"walking_up\":
					sprite.play(\"back\")

	move_and_slide()
"

